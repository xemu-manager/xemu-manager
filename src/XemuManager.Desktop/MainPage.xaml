<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XemuManager.Desktop.MainPage">

    <VerticalStackLayout
        Padding="30"
        Spacing="15">
        <Label
            Text="Game file (.iso / .xiso)" />

        <Entry
            x:Name="GamePathEntry"
            Placeholder="D:\Games\Halo.iso" />

        <Button
            x:Name="LaunchBtn"
            Text="Launch"
            Clicked="OnLaunchClicked"
            HorizontalOptions="Fill" />

        <Label
            x:Name="StatusLabel"
            LineBreakMode="WordWrap" />
    </VerticalStackLayout>

</ContentPage>
